# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_HOST=0.0.0.0
TELEGRAM_WEBHOOK_PORT=8080
# Telegram user ID that receives notifications when users change AI settings
ADMIN_TELEGRAM_USER_ID=

# AI provider (OpenAI-compatible)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_DEFAULT_PROVIDER=default
# Optional named provider profiles. Each profile can use OpenAI-compatible /chat/completions.
AI_PROVIDERS_JSON=
# Optional JSON merged into the chat/completions request (e.g. temperature, top_p, reasoning settings supported by your provider)
AI_EXTRA_BODY_JSON=
AI_TIMEOUT_SECONDS=120
AI_MAX_HISTORY_MESSAGES=20
# Speech-to-text model used by Responses-compatible providers.
AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_VIDEO_TRANSCRIPTION_ENABLED=true
AI_TRANSCRIPTION_MAX_SECONDS=300
AI_SYSTEM_PROMPT=

# Storage
DATABASE_PATH=/app/data/telechatbot.db
# Fernet key for encrypting per-user custom API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CUSTOM_SETTINGS_ENCRYPTION_KEY=

# Attachment handling
ATTACHMENT_MAX_MB=20
# Separate lower limit for images to avoid oversized base64/native payloads.
ATTACHMENT_MAX_IMAGE_MB=5
ATTACHMENT_MAX_PROMPT_CHARS=30000
ATTACHMENT_DIR=/app/data/attachments

LOG_LEVEL=INFO
